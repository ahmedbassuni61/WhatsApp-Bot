# ============================================
# College Assistant AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys
# Get free API keys from the URLs listed below

# --- LLM Providers (All Free Tier) ---

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- WhatsApp (Evolution API) ---
ANNOUNCEMENT_GROUP_JID = your_announcement_group_jid_here

# API key for Evolution API (set during docker-compose setup)
EVOLUTION_API_KEY=my_secure_bot_key_2026

# Evolution API base URL (default if running locally via Docker)
EVOLUTION_API_URL=http://localhost:8080

# Evolution API instance name
EVOLUTION_INSTANCE_NAME=college-bot

# --- Google APIs ---

# Google Calendar API credentials file path
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Google Calendar ID (default: primary)
GOOGLE_CALENDAR_ID=primary

# Google Drive Root Folder ID (from folder URL: drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_FOLDER_ID=1oVFxVUEWi1m98vyIGd8pkei6mQrwo47o

# --- App Config ---

# FastAPI backend port
API_PORT=8000

# Timezone for date/time resolution & Google Calendar sync (e.g. Africa/Cairo)
TIMEZONE=Africa/Cairo

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
